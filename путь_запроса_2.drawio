        <mxCell id="pt_v33" value="27. journal фиксирует DELIVERED / FAILED.&lt;br&gt;Потребитель узнаёт итог: webhook-подписка&lt;br&gt;или GET через Query API" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=12;align=left;spacingLeft=6;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1736" y="1847" width="320" height="60" as="geometry" />
