        <mxCell id="bt_v18" value="&lt;b&gt;Обработка чанка: отдельный пул, масштабируется по lag (KEDA)&lt;/b&gt;" style="rounded=0;html=1;fillColor=#ECEFF1;strokeColor=none;fontColor=#455A64;fontSize=14;align=left;spacingLeft=10;" parent="1" vertex="1">
