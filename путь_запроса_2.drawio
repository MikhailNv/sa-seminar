        <mxCell id="bt_v1" value="&lt;b&gt;Задание 2. Массовый запрос (batch): от кампании до передачи провайдеру&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#404040&quot;&gt;Пример: маркетинговая рассылка на 200 000 получателей. Отличия от point: отдельные деплойменты, топики, очереди и доля лимита провайдера.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="40" y="20" width="2184" height="70" as="geometry" />
        </mxCell>
        <mxCell id="bt_v2" value="&lt;b&gt;Синхронный приём задания&lt;/b&gt;" style="rounded=0;html=1;fillColor=#ECEFF1;strokeColor=none;fontColor=#455A64;fontSize=14;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="40" y="220" width="2184" height="28" as="geometry" />
        </mxCell>
        <mxCell id="bt_e3" value="1. POST /v1/batches ·&lt;br&gt;шаблон, каналы, аудитория&lt;br&gt;(сегмент или файл импорта),&lt;br&gt;send_at, Idempotency-Key" style="html=1;endArrow=block;endFill=1;strokeColor=#2E7D32;strokeWidth=2;fontSize=12;fontColor=#2E7D32;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=2;" parent="1" edge="1">
          <mxGeometry y="8" relative="1" as="geometry">
            <mxPoint x="124" y="334" as="sourcePoint" />
            <mxPoint x="292" y="334" as="targetPoint" />
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="bt_v4" value="2. JWT · отдельная квота batch тенанта ·&lt;br&gt;маршрут на batch-деплоймент" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#C0A000;fontSize=12;align=left;spacingLeft=6;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="132" y="346" width="320" height="44" as="geometry" />
        </mxCell>
        <mxCell id="bt_e5" value="3. проксирование в batch-&lt;br&gt;деплоймент" style="html=1;endArrow=block;endFill=1;strokeColor=#2E7D32;strokeWidth=2;fontSize=12;fontColor=#2E7D32;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=2;" parent="1" edge="1">
          <mxGeometry x="0.0238" y="9" relative="1" as="geometry">
            <mxPoint x="292" y="446" as="sourcePoint" />
            <mxPoint x="460" y="446" as="targetPoint" />
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="bt_e6" value="4. content ‖ config: шаблон&lt;br&gt;и каналы; audience: оценка&lt;br&gt;аудитории" style="html=1;endArrow=block;endFill=1;strokeColor=#2E7D32;strokeWidth=2;fontSize=12;fontColor=#2E7D32;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=2;" parent="1" edge="1">
          <mxGeometry x="0.0119" y="8" relative="1" as="geometry">
            <mxPoint x="460" y="517" as="sourcePoint" />
            <mxPoint x="628" y="517" as="targetPoint" />
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="bt_e7" value="5. ok · N получателей · M&lt;br&gt;исключено (excluded[] с&lt;br&gt;причинами)" style="html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=12;fontColor=#555555;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=2;dashed=1;dashPattern=6 4;" parent="1" edge="1">
          <mxGeometry x="0.0238" y="-11" relative="1" as="geometry">
            <mxPoint x="628" y="588" as="sourcePoint" />
            <mxPoint x="460" y="588" as="targetPoint" />
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="bt_v8" value="6. Admission control: активные задания тенанта (счётчик в&lt;br&gt;Valkey) сравниваются с порогом из config. Порог превышен —&lt;br&gt;задание принимается в статусе WAITING_CAPACITY и стартует&lt;br&gt;позже. Point это не затрагивает" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#C0A000;fontSize=12;align=left;spacingLeft=6;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="249.6" y="600" width="420.8" height="74" as="geometry" />
        </mxCell>
        <mxCell id="bt_e9" value="7. gRPC CreateBatch" style="html=1;endArrow=block;endFill=1;strokeColor=#2E7D32;strokeWidth=2;fontSize=12;fontColor=#2E7D32;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=2;" parent="1" edge="1">
          <mxGeometry x="0.006" y="8" relative="1" as="geometry">
            <mxPoint x="460" y="715" as="sourcePoint" />
            <mxPoint x="796" y="715" as="targetPoint" />
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="bt_v10" value="8. Одна транзакция: batch_job (ACCEPTED) +&lt;br&gt;outbox batch.requested" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#C0A000;fontSize=12;align=left;spacingLeft=6;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="636" y="727" width="320" height="44" as="geometry" />
        </mxCell>
        <mxCell id="bt_e11" value="9. 202 Accepted {batch_id} · прогресс. Query API или экран кампании" style="html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=12;fontColor=#555555;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=2;dashed=1;dashPattern=6 4;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="796" y="812" as="sourcePoint" />
            <mxPoint x="124" y="812" as="targetPoint" />
            <mxPoint y="-11.5" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="bt_v12" value="&lt;b&gt;Нарезка на чанки (в send_at или сразу)&lt;/b&gt;" style="rounded=0;html=1;fillColor=#ECEFF1;strokeColor=none;fontColor=#455A64;fontSize=14;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="40" y="830" width="2184" height="28" as="geometry" />
        </mxCell>
        <mxCell id="bt_e13" value="10. Debezium →&lt;br&gt;batch.requests" style="html=1;endArrow=block;endFill=1;strokeColor=#1F4E9C;strokeWidth=2;fontSize=12;fontColor=#1F4E9C;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=2;" parent="1" edge="1">
          <mxGeometry y="9" relative="1" as="geometry">
            <mxPoint x="796" y="914" as="sourcePoint" />
            <mxPoint x="964" y="914" as="targetPoint" />
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="bt_e14" value="11. consume" style="html=1;endArrow=block;endFill=1;strokeColor=#1F4E9C;strokeWidth=2;fontSize=12;fontColor=#1F4E9C;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=2;" parent="1" edge="1">
          <mxGeometry x="-0.0238" y="7" relative="1" as="geometry">
            <mxPoint x="964" y="955" as="sourcePoint" />
            <mxPoint x="1132" y="955" as="targetPoint" />
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="bt_e15" value="12. audience: постраничный резолв сегмента (keyset)" style="html=1;endArrow=block;endFill=1;strokeColor=#2E7D32;strokeWidth=2;fontSize=12;fontColor=#2E7D32;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=2;" parent="1" edge="1">
          <mxGeometry x="0.004" y="-7" relative="1" as="geometry">
            <mxPoint x="1132" y="996" as="sourcePoint" />
            <mxPoint x="628" y="996" as="targetPoint" />
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="bt_v16" value="13. Чанки по 500–1000 получателей: batch_chunk&lt;br&gt;+ outbox batch.chunk.ready (ключ batch_id)" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#C0A000;fontSize=12;align=left;spacingLeft=6;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="972" y="1008" width="320" height="44" as="geometry" />
        </mxCell>
        <mxCell id="bt_e17" value="14. batch.chunks" style="html=1;endArrow=block;endFill=1;strokeColor=#1F4E9C;strokeWidth=2;fontSize=12;fontColor=#1F4E9C;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=2;" parent="1" edge="1">
