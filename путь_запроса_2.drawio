        <mxCell id="pt_v24" value="&lt;b&gt;Успешная передача провайдеру&lt;/b&gt;" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;fontColor=#2E7D32;fontSize=14;" parent="1" vertex="1">
