        <mxCell id="bt_e21" value="17. Render: шаблон&lt;br&gt;загружается 1 раз на чанк,&lt;br&gt;персонализация на получателя" style="html=1;endArrow=block;endFill=1;strokeColor=#2E7D32;strokeWidth=2;fontSize=12;fontColor=#2E7D32;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=2;" parent="1" edge="1">
