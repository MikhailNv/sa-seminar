          </mxGeometry>
        </mxCell>
        <mxCell id="pt_e7" value="5. allow по каждой проверке" style="html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=12;fontColor=#555555;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=2;dashed=1;dashPattern=6 4;" parent="1" edge="1">
