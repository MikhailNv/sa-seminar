          </mxGeometry>
        </mxCell>
        <mxCell id="pt_e17" value="14. текст / HTML / QR →&lt;br&gt;rendered/{id}/{канал} в S3" style="html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=12;fontColor=#555555;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=2;dashed=1;dashPattern=6 4;" parent="1" edge="1">
