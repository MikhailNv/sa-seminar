        <mxCell id="bt_e19" value="15. consume чанка; при росте lag KEDA добавляет поды" style="html=1;endArrow=block;endFill=1;strokeColor=#1F4E9C;strokeWidth=2;fontSize=12;fontColor=#1F4E9C;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=2;" parent="1" edge="1">
