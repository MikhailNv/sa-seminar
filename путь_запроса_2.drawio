        <mxCell id="pt_v25" value="20. Одна транзакция: deliveries = SENT + outbox&lt;br&gt;notification.sent. Только после коммита ack в RabbitMQ" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=12;align=left;spacingLeft=6;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1442.4" y="1484" width="387.2" height="44" as="geometry" />
        </mxCell>
