        <mxCell id="er_ll0" style="endArrow=none;html=1;strokeColor=#9AA3AF;dashed=1;dashPattern=4 4;strokeWidth=1.5;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="124" y="184" as="sourcePoint" />
            <mxPoint x="124" y="2278" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="er_v1" value="&lt;b&gt;Задание 2. Сценарий с ошибкой и меры реагирования администраторов&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:14px;color:#404040&#39;&gt;Цепочка защиты: повторы → circuit breaker → резервный провайдер → DLQ → алерт → ручные действия. Сообщение не теряется ни на одном шаге.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="40" y="20" width="2184" height="70" as="geometry" />
        </mxCell>
        <mxCell id="er_v2" value="&lt;b&gt;A. Ошибка на приёме: синхронно, ничего не создаётся&lt;/b&gt;" style="rounded=0;html=1;fillColor=#ECEFF1;strokeColor=none;fontColor=#455A64;fontSize=14;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="40" y="220" width="2184" height="28" as="geometry" />
        </mxCell>
        <mxCell id="er_e3" value="E1. POST /v1/notifications" style="html=1;endArrow=block;endFill=1;strokeColor=#2E7D32;strokeWidth=2;fontSize=12;fontColor=#2E7D32;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=2;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="124" y="289" as="sourcePoint" />
            <mxPoint x="292" y="289" as="targetPoint" />
            <mxPoint y="-11.5" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="er_e4" value="E2. 401 / 403 токен · 429&lt;br&gt;квота исчерпана" style="html=1;endArrow=block;endFill=1;strokeColor=#C62828;strokeWidth=2;fontSize=12;fontColor=#C62828;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=2;dashed=1;dashPattern=6 4;" parent="1" edge="1">
          <mxGeometry x="0.0119" y="-12" relative="1" as="geometry">
            <mxPoint x="292" y="345" as="sourcePoint" />
            <mxPoint x="124" y="345" as="targetPoint" />
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="er_e5" value="E3. запрос прошёл шлюз" style="html=1;endArrow=block;endFill=1;strokeColor=#2E7D32;strokeWidth=2;fontSize=12;fontColor=#2E7D32;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=2;" parent="1" edge="1">
          <mxGeometry x="-0.0238" y="9" relative="1" as="geometry">
            <mxPoint x="292" y="386" as="sourcePoint" />
            <mxPoint x="460" y="386" as="targetPoint" />
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="er_e6" value="E4. 422 шаблон, данные, вложение · 409 тот же ключ с&lt;br&gt;другим телом · 503 зависимость недоступна" style="html=1;endArrow=block;endFill=1;strokeColor=#C62828;strokeWidth=2;fontSize=12;fontColor=#C62828;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=2;dashed=1;dashPattern=6 4;" parent="1" edge="1">
          <mxGeometry x="0.006" y="-9" relative="1" as="geometry">
            <mxPoint x="460" y="442" as="sourcePoint" />
            <mxPoint x="124" y="442" as="targetPoint" />
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="er_v7" value="E5. Потребитель повторяет запрос с тем же&lt;br&gt;Idempotency-Key: дубля не будет" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#C0A000;fontSize=12;align=left;spacingLeft=6;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="454" width="320" height="44" as="geometry" />
        </mxCell>
        <mxCell id="er_v8" value="&lt;b&gt;B. Временный сбой провайдера: повторы со ступенчатой задержкой&lt;/b&gt;" style="rounded=0;html=1;fillColor=#ECEFF1;strokeColor=none;fontColor=#455A64;fontSize=14;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="40" y="516" width="2184" height="28" as="geometry" />
        </mxCell>
        <mxCell id="er_e9" value="E6. доставка из&lt;br&gt;send.sms.prov1.point" style="html=1;endArrow=block;endFill=1;strokeColor=#1F4E9C;strokeWidth=2;fontSize=12;fontColor=#1F4E9C;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=2;" parent="1" edge="1">
          <mxGeometry y="8" relative="1" as="geometry">
            <mxPoint x="796" y="600" as="sourcePoint" />
            <mxPoint x="964" y="600" as="targetPoint" />
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="er_e10" value="E7. submit_sm" style="html=1;endArrow=block;endFill=1;strokeColor=#2E7D32;strokeWidth=2;fontSize=12;fontColor=#2E7D32;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=2;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="964" y="641" as="sourcePoint" />
            <mxPoint x="1132" y="641" as="targetPoint" />
            <mxPoint y="-11.5" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="er_e11" value="E8. таймаут · 5xx ·&lt;br&gt;throttling" style="html=1;endArrow=block;endFill=1;strokeColor=#C62828;strokeWidth=2;fontSize=12;fontColor=#C62828;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=2;dashed=1;dashPattern=6 4;" parent="1" edge="1">
          <mxGeometry x="-0.0119" y="-9" relative="1" as="geometry">
            <mxPoint x="1132" y="697" as="sourcePoint" />
            <mxPoint x="964" y="697" as="targetPoint" />
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="er_v12" value="E9. Ошибка временная → attempts + 1, статус&lt;br&gt;RETRY_SCHEDULED (транзакция + outbox&lt;br&gt;notification.retry)" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=12;align=left;spacingLeft=6;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="787.2" y="709" width="353.6" height="59" as="geometry" />
        </mxCell>
        <mxCell id="er_e13" value="E10. publish retry.sms.1m →&lt;br&gt;5m → 15m → 1h → 6h (TTL +&lt;br&gt;DLX)" style="html=1;endArrow=block;endFill=1;strokeColor=#E65100;strokeWidth=2;fontSize=12;fontColor=#E65100;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=2;" parent="1" edge="1">
          <mxGeometry y="-10" relative="1" as="geometry">
            <mxPoint x="964" y="839" as="sourcePoint" />
            <mxPoint x="796" y="839" as="targetPoint" />
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="er_e14" value="E11. по истечении TTL&lt;br&gt;сообщение возвращается в&lt;br&gt;send" style="html=1;endArrow=block;endFill=1;strokeColor=#E65100;strokeWidth=2;fontSize=12;fontColor=#E65100;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=2;" parent="1" edge="1">
          <mxGeometry y="8" relative="1" as="geometry">
            <mxPoint x="796" y="910" as="sourcePoint" />
            <mxPoint x="964" y="910" as="targetPoint" />
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="er_v15" value="&lt;b&gt;C. Провайдер лежит: circuit breaker и переключение на резервного&lt;/b&gt;" style="rounded=0;html=1;fillColor=#ECEFF1;strokeColor=none;fontColor=#455A64;fontSize=14;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="40" y="928" width="2184" height="28" as="geometry" />
        </mxCell>
        <mxCell id="er_v16" value="E12. Доля ошибок prov1 &amp;gt; 50% в окне 30 с → circuit&lt;br&gt;breaker OPEN. Отправки к prov1 больше не делаются" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=12;align=left;spacingLeft=6;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="787.2" y="968" width="353.6" height="44" as="geometry" />
        </mxCell>
        <mxCell id="er_e17" value="E13. отправка через резервного провайдера (маршрут&lt;br&gt;config: основной + резерв)" style="html=1;endArrow=block;endFill=1;strokeColor=#E65100;strokeWidth=2;fontSize=12;fontColor=#E65100;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=2;" parent="1" edge="1">
          <mxGeometry y="7" relative="1" as="geometry">
            <mxPoint x="964" y="1068" as="sourcePoint" />
            <mxPoint x="1300" y="1068" as="targetPoint" />
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="er_e18" value="E14. ACK + provider_message_id" style="html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=12;fontColor=#555555;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=2;dashed=1;dashPattern=6 4;" parent="1" edge="1">
          <mxGeometry x="0.006" y="-10" relative="1" as="geometry">
            <mxPoint x="1300" y="1109" as="sourcePoint" />
            <mxPoint x="964" y="1109" as="targetPoint" />
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="er_e19" value="" style="endArrow=none;html=1;strokeColor=#2E7D32;strokeWidth=3;dashed=1;dashPattern=8 4;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="40" y="1139" as="sourcePoint" />
            <mxPoint x="2224" y="1139" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="er_v20" value="&lt;b&gt;Сообщение передано резервному провайдеру&amp;nbsp;&lt;/b&gt;" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;fontColor=#2E7D32;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="872" y="1124" width="520" height="30" as="geometry" />
        </mxCell>
        <mxCell id="er_e21" value="E15. notification.sent · provider.circuit.opened" style="html=1;endArrow=block;endFill=1;strokeColor=#1F4E9C;strokeWidth=2;fontSize=12;fontColor=#1F4E9C;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=2;" parent="1" edge="1">
          <mxGeometry x="0.0079" y="6" relative="1" as="geometry">
            <mxPoint x="964" y="1204" as="sourcePoint" />
            <mxPoint x="1468" y="1204" as="targetPoint" />
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="er_v22" value="E16. Через 60 с HALF_OPEN: пробные запросы к prov1,&lt;br&gt;при успехе маршрут возвращается на основного" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=12;align=left;spacingLeft=6;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="787.2" y="1216" width="353.6" height="44" as="geometry" />
        </mxCell>
        <mxCell id="er_v23" value="&lt;b&gt;D. Постоянная ошибка: повторять бессмысленно&lt;/b&gt;" style="rounded=0;html=1;fillColor=#ECEFF1;strokeColor=none;fontColor=#455A64;fontSize=14;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="40" y="1278" width="2184" height="28" as="geometry" />
        </mxCell>
        <mxCell id="er_e24" value="E17. неверный номер ·&lt;br&gt;абонент заблокирован, отказ&lt;div&gt;&lt;div&gt;валидации&lt;/div&gt;&lt;/div&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#C62828;strokeWidth=2;fontSize=12;fontColor=#C62828;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=2;dashed=1;dashPattern=6 4;" parent="1" edge="1">
          <mxGeometry x="0.0119" y="-11" relative="1" as="geometry">
            <mxPoint x="1132" y="1377" as="sourcePoint" />
            <mxPoint x="964" y="1377" as="targetPoint" />
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="er_v25" value="E18. Без повторов: FAILED с кодом провайдера. Если&lt;br&gt;в запросе указан резервный канал (например, e-mail&lt;br&gt;вместо SMS) — создаётся доставка по нему" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontSize=12;align=left;spacingLeft=6;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="787.2" y="1389" width="353.6" height="59" as="geometry" />
        </mxCell>
        <mxCell id="er_e26" value="E19. notification.failed → журнал → webhook потребителю" style="html=1;endArrow=block;endFill=1;strokeColor=#1F4E9C;strokeWidth=2;fontSize=12;fontColor=#1F4E9C;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=2;" parent="1" edge="1">
          <mxGeometry x="0.004" y="7" relative="1" as="geometry">
            <mxPoint x="964" y="1489" as="sourcePoint" />
            <mxPoint x="1468" y="1489" as="targetPoint" />
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="er_v27" value="&lt;b&gt;E. Исчерпаны попытки: оба провайдера недоступны&lt;/b&gt;" style="rounded=0;html=1;fillColor=#ECEFF1;strokeColor=none;fontColor=#455A64;fontSize=14;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="40" y="1507" width="2184" height="28" as="geometry" />
        </mxCell>
        <mxCell id="er_e28" value="E20. 5 попыток → dlq.sms" style="html=1;endArrow=block;endFill=1;strokeColor=#C62828;strokeWidth=2;fontSize=12;fontColor=#C62828;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=2;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="800" y="1566" as="sourcePoint" />
            <mxPoint x="800" y="1584" as="targetPoint" />
            <Array as="points">
              <mxPoint x="856" y="1566" />
              <mxPoint x="856" y="1584" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="er_v29" value="E21. Статус DEAD_LETTERED: сообщение хранится в DLQ и&lt;br&gt;PostgreSQL, не потеряно и ждёт разбора" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontSize=12;align=left;spacingLeft=6;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="434.4" y="1596" width="387.2" height="44" as="geometry" />
        </mxCell>
        <mxCell id="er_e30" value="E22. notification.failed {reason: dlq}" style="html=1;endArrow=block;endFill=1;strokeColor=#1F4E9C;strokeWidth=2;fontSize=12;fontColor=#1F4E9C;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=2;" parent="1" edge="1">
          <mxGeometry y="9" relative="1" as="geometry">
            <mxPoint x="628" y="1681" as="sourcePoint" />
            <mxPoint x="1468" y="1681" as="targetPoint" />
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="er_v31" value="&lt;b&gt;F. Обнаружение и реакция администраторов&lt;/b&gt;" style="rounded=0;html=1;fillColor=#ECEFF1;strokeColor=none;fontColor=#455A64;fontSize=14;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="40" y="1699" width="2184" height="28" as="geometry" />
        </mxCell>
        <mxCell id="er_e32" value="E23. метрики: глубина DLQ, доля ошибок провайдера, состояние CB, lag Kafka, возраст outbox" style="html=1;endArrow=block;endFill=1;strokeColor=#1F4E9C;strokeWidth=2;fontSize=12;fontColor=#1F4E9C;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=2;" parent="1" edge="1">
          <mxGeometry x="-0.0024" y="8" relative="1" as="geometry">
            <mxPoint x="796" y="1768" as="sourcePoint" />
            <mxPoint x="1636" y="1768" as="targetPoint" />
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="er_e33" value="E24. алерт напрямую:&lt;br&gt;Telegram-бот дежурных +&amp;nbsp;&lt;div&gt;SMS&lt;br&gt;через отдельную учётную&lt;br&gt;запись&amp;nbsp; в обход модуля&lt;/div&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#C62828;strokeWidth=3;fontSize=12;fontColor=#C62828;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=2;" parent="1" edge="1">
          <mxGeometry x="-0.0238" y="9" relative="1" as="geometry">
            <mxPoint x="1636" y="1854" as="sourcePoint" />
            <mxPoint x="1804" y="1854" as="targetPoint" />
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="er_e34" value="E25. Grafana: что упало ·&lt;br&gt;журнал и OpenSearch по&lt;br&gt;trace_id · коды провайдера" style="html=1;endArrow=block;endFill=1;strokeColor=#6A1B9A;strokeWidth=2;fontSize=12;fontColor=#6A1B9A;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=2;" parent="1" edge="1">
          <mxGeometry y="10" relative="1" as="geometry">
            <mxPoint x="1804" y="1925" as="sourcePoint" />
            <mxPoint x="1972" y="1925" as="targetPoint" />
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="er_e35" value="E26. действие 1: перевести&lt;br&gt;маршрут на резервного /&lt;br&gt;выключить провайдера →&lt;br&gt;config.changed" style="html=1;endArrow=block;endFill=1;strokeColor=#6A1B9A;strokeWidth=2;fontSize=12;fontColor=#6A1B9A;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=2;" parent="1" edge="1">
          <mxGeometry y="10" relative="1" as="geometry">
            <mxPoint x="1972" y="2011" as="sourcePoint" />
            <mxPoint x="2140" y="2011" as="targetPoint" />
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="er_e36" value="E27. действие 2: пауза batch-кампаний канала. Лимит провайдера освобождается под point" style="html=1;endArrow=block;endFill=1;strokeColor=#6A1B9A;strokeWidth=2;fontSize=12;fontColor=#6A1B9A;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=2;" parent="1" edge="1">
          <mxGeometry y="-8" relative="1" as="geometry">
            <mxPoint x="1972" y="2052" as="sourcePoint" />
            <mxPoint x="628" y="2052" as="targetPoint" />
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="er_e37" value="E28. действие 3: после восстановления. re-drive DLQ (выборочно или целиком) в send" style="html=1;endArrow=block;endFill=1;strokeColor=#6A1B9A;strokeWidth=2;fontSize=12;fontColor=#6A1B9A;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=2;" parent="1" edge="1">
          <mxGeometry x="0.0034" y="-9" relative="1" as="geometry">
            <mxPoint x="1972" y="2093" as="sourcePoint" />
            <mxPoint x="796" y="2093" as="targetPoint" />
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="er_v38" value="E29. Повторная отправка не создаёт дублей: перед вызовом&lt;br&gt;адаптер проверяет статус доставки и lock:{delivery_id}" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontSize=12;align=left;spacingLeft=6;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="602.4" y="2105" width="387.2" height="44" as="geometry" />
        </mxCell>
        <mxCell id="er_e39" value="E30. действие 4: постоянные ошибки — сообщить владельцу системы-потребителя (данные, шаблон)" style="html=1;endArrow=block;endFill=1;strokeColor=#6A1B9A;strokeWidth=2;fontSize=12;fontColor=#6A1B9A;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=2;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1972" y="2190" as="sourcePoint" />
            <mxPoint x="124" y="2190" as="targetPoint" />
            <mxPoint y="-11.5" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="er_v40" value="E31. Закрыть инцидент · постмортем · все действия&lt;br&gt;администратора записаны в аудит journal" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontSize=12;align=left;spacingLeft=6;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1610.4" y="2202" width="387.2" height="44" as="geometry" />
        </mxCell>
        <mxCell id="er_v41" value="&lt;b&gt;Потребитель&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:11px;color:#0B5394&#39;&gt;система или Back-office&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#2F5597;strokeWidth=2;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="46" y="110" width="156" height="74" as="geometry" />
        </mxCell>
        <mxCell id="er_v42" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:11px;color:#0B5394&#39;&gt;APISIX&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=2;fontSize=13;" parent="1" vertex="1">
