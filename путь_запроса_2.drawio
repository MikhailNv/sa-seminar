        <mxCell id="pt_v12" value="&lt;b&gt;Асинхронная обработка: потребитель уже получил ответ&lt;/b&gt;" style="rounded=0;html=1;fillColor=#ECEFF1;strokeColor=none;fontColor=#455A64;fontSize=14;align=left;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="40" y="800" width="2016" height="28" as="geometry" />
