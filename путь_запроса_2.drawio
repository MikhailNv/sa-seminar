        <mxCell id="ov_v59" value="&lt;b style=&quot;color:#2E7D32&quot;&gt;Point (стр. 1)&lt;/b&gt;&lt;br&gt;1 запрос потребителя&lt;div&gt;2 шлюз: JWT, квота&lt;/div&gt;&lt;div&gt;3 Notification API (point)&lt;/div&gt;&lt;div&gt;4 проверки content ‖ config ‖ audience&lt;/div&gt;&lt;div&gt;6–7 приём: PostgreSQL + outbox, 202&lt;/div&gt;&lt;div&gt;10 Debezium → Kafka&lt;/div&gt;&lt;div&gt;12 обработчик point, lock&lt;/div&gt;&lt;div&gt;13 рендер&lt;/div&gt;&lt;div&gt;15 маршрут провайдера&lt;/div&gt;&lt;div&gt;16–17 RabbitMQ .point&lt;/div&gt;&lt;div&gt;18 передача провайдеру&lt;/div&gt;&lt;div&gt;20–22 SENT → журнал&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="Lpoint" vertex="1">
