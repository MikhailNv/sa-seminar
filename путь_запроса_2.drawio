        </mxCell>
        <mxCell id="pt_v18" value="15. Маршрут «канал → провайдеры» из кэша config:&lt;br&gt;основной провайдер, circuit breaker закрыт. Статус&lt;br&gt;QUEUED + outbox notification.rendered" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#C0A000;fontSize=12;align=left;spacingLeft=6;verticalAlign=middle;" parent="1" vertex="1">
