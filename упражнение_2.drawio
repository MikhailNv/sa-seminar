  <diagram name="Page-1" id="cVUn2GP6C2mejhBehfDB">
    <mxGraphModel dx="1868" dy="1464" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam componentStyle rectangle\nskinparam backgroundColor #FEFEFE\nskinparam shadowing false\nskinparam defaultFontName Arial\n\ntitle SuperSurance Architecture - Exercise 2: Domain Segmentation\n\n&#39; --- Каналы продаж ---\npackage \&quot;Каналы подачи заявок (Clients)\&quot; #F8F9FA {\n    [Сайт] as site\n    [Мобильное приложение] as mobile\n    [Партнерская сеть] as partners\n}\n\n&#39; --- API Gateway ---\npackage \&quot;Точка входа\&quot; #FFF3CD {\n    [API Gateway] as gw\n    note right of gw\n        Маршрутизация, Rate Limiting,\n        Аутентификация, Балансировка\n    end note\n}\n\n&#39; --- Доменные сервисы ---\npackage \&quot;Доменные сервисы (Domain Services)\&quot; {\n    \n    package \&quot;Customer Domain\&quot; #D4EDDA {\n        [Customer Service\\n(Управление клиентами)] as customer_svc\n        [(Customer DB)] as customer_db\n    }\n    \n    package \&quot;Product Domain\&quot; #D4EDDA {\n        [Product Service\\n(Тарифы и правила)] as product_svc\n        [(Product DB)] as product_db\n    }\n    \n    package \&quot;Proposal Domain\&quot; #D4EDDA {\n        [Proposal Service\\n(Расчет и предложения)] as proposal_svc\n        [(Proposal DB)] as proposal_db\n    }\n    \n    package \&quot;Portfolio Domain\&quot; #D4EDDA {\n        [Portfolio Service\\n(Мониторинг портфеля)] as portfolio_svc\n        [(Portfolio DB)] as portfolio_db\n    }\n}\n\n&#39; --- Интеграционный сервис ---\npackage \&quot;Integration Service\&quot; #CCE5FF {\n    [Integration Service\\n(Внешние API + ACL + Кэш)] as integration_svc\n    [(Integration Cache\\nRedis)] as cache_db\n}\n\n&#39; --- Внешние партнеры ---\npackage \&quot;Внешние платные сервисы\&quot; #E2E3E5 {\n    [История ремонта ТС] as p1\n    [Рыночная стоимость ТС] as p2\n    [История штрафов] as p3\n    [Антифрод система] as p4\n}\n\n&#39; --- Связи: Клиенты -&gt; Gateway ---\nsite --&gt; gw : HTTPS\nmobile --&gt; gw : HTTPS\npartners --&gt; gw : HTTPS/API\n\n&#39; --- Связи: Gateway -&gt; Сервисы ---\ngw --&gt; customer_svc : REST API\ngw --&gt; product_svc : REST API\ngw --&gt; proposal_svc : REST API\ngw --&gt; portfolio_svc : REST API\n\n&#39; --- Связи: Сервисы -&gt; БД ---\ncustomer_svc --&gt; customer_db : Read/Write\nproduct_svc --&gt; product_db : Read/Write\nproposal_svc --&gt; proposal_db : Read/Write\nportfolio_svc --&gt; portfolio_db : Read/Write\n\n&#39; --- Межсервисное взаимодействие ---\nproposal_svc --&gt; product_svc : REST: Получить тарифы\nproposal_svc --&gt; customer_svc : REST: Получить данные клиента\nproposal_svc --&gt; integration_svc : REST: Запросить внешние данные\nportfolio_svc --&gt; customer_svc : REST: Получить данные клиента\nportfolio_svc --&gt; proposal_svc : REST: Получить предложения\n\n&#39; --- Интеграционный сервис -&gt; Партнеры ---\nintegration_svc --&gt; cache_db : Кэш запросов\nintegration_svc --&gt; p1 : API Call\nintegration_svc --&gt; p2 : API Call\nintegration_svc --&gt; p3 : API Call\nintegration_svc --&gt; p4 : API Call\n\nnote bottom of integration_svc\n    Anti-Corruption Layer (ACL):\n    Трансформация внешних DTO\n    во внутренние модели\nend note\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Fz_PEqNUjtUYYoTkM-O3-1">
